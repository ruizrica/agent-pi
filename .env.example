# Agent Pi Environment Variables
# Copy this file to .env and fill in real values for development

# ── Test Credentials ────────────────────────────────────────────────
# Used in test fixtures (test-gen-parser.test.ts)
TEST_LOGIN_PASSWORD=test-password

# ── OAuth Tokens (Development Mocks) ────────────────────────────────
# Mock tokens for local development/testing OAuth flows
PI_CLAUDE_OAUTH_TOKEN=cc-token
ANTHROPIC_OAUTH_TOKEN=anthropic-token
CLAUDE_CODE_OAUTH_TOKEN=claude-code-token

# ── External Services ───────────────────────────────────────────────
# AgentMail API key (get from https://agentmail.ai)
AGENTMAIL_API_KEY=your-agentmail-api-key

# Jira API token (optional, for Jira integration)
JIRA_API_TOKEN=your-jira-token

# ── Claude API Keys ─────────────────────────────────────────────────
# For production use, set real API keys
# CLAUDE_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
