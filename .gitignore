# Dependencies
node_modules/

# OS
.DS_Store

# IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo

# Runtime / user config (not distributable)
.context/
bun.lock
extensions/coverage/
extensions/.pi/
extensions/__tests__/.pi/
extensions/node_modules/
extensions/web-test-worker/.env
extensions/settings.json
extensions/web-test-worker/node_modules/
autoresearch-results.tsv

# Private content — NEVER tracked, NEVER pushed
skills/private/
extensions/private/
extensions/__tests__/private/
commands/private/
.private-patterns
.github/

# Runtime / Pi state
.pi/

# Stakpak session files
.stakpak/session*

# Mako Security
.mako-security.yml
.makoignore

# Generated tooling / IDE drafts (not product source)
.gopher/
.kiro/
tests/*.spec.ts

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Task tracker — entire directories are local-only (config, hooks, state).
# Hooks live here from `bd init` and are machine-specific; we don't want them
# tracked on the public repo. Reinstall locally with `bd init` after cloning.
.beads/
.commander/

# Claude per-machine settings overrides (user-specific allow-lists, paths)
.claude/settings.local.json

