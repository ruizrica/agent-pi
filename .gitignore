.mako-security.yml
.makoignore

# Generated tooling / IDE drafts (not product source)
.gopher/
.kiro/
tests/*.spec.ts

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Task tracker volatile state (per-session, never push to public)
# `**/<name>` covers root + any nested depth; trailing-slash variants are kept
# for explicitness so directories are unambiguously matched. Existing tracked
# files under `.beads/` (config.yaml, hooks, README) are unaffected — gitignore
# only applies to untracked paths.
.beads
.beads/
**/.beads
**/.beads/
.commander
.commander/
**/.commander
**/.commander/

# Specific volatile files within the root `.beads/` (redundant given the
# globs above, but kept as documentation of which files are per-session).
.beads/issues.jsonl
.beads/cmd-writer.log
.beads/metadata.json

