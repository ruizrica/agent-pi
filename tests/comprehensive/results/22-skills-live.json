    {
      "title": "pi --skill <path> blows past OpenRouter 200K context window",
      "expected": "Loading any skill via --skill should fit within the model context, including system extensions",
      "observed": "Live skill loading consumes ~262K tokens \u2014 exceeds OpenRouter's 200K hard limit. memory-cycle extension contributes most of the bloat.",
      "impact": "Skills cannot be live-probed end-to-end on OpenRouter providers. Forces static fallback for skills tests.",
      "severity": "high"
    },
    {
      "title": "qa-automation skill is missing SKILL.md entrypoint",
      "expected": "Every skill directory contains SKILL.md (canonical discovery file)",
      "observed": "qa-automation/ (252KB) has README.md and install.sh instead of SKILL.md",
      "impact": "Skill is not discoverable by pi via the standard skill resolver",
      "severity": "medium"
    }
  ],
  "improvements": [
    {
      "id": "imp-skills-lazy",
      "title": "Lazy-load SKILL.md content on demand",
      "description": "Currently SKILL.md is read upfront for every loaded skill, contributing to 262K tokens of context per pi invocation. Lazy-loading would defer reads until the skill is actually triggered.",
      "severity": "high"
    },
    {
      "id": "imp-memory-cycle-bloat",
